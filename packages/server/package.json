{
	"name": "@hocuspocus/server",
	"description": "plug & play collaboration backend",
	"version": "3.4.3",
	"homepage": "https://hocuspocus.dev",
	"keywords": [
		"hocuspocus",
		"yjs",
		"yjs-websocket",
		"prosemirror",
		"collaboration",
		"crdt",
		"runtime-agnostic",
		"nodejs",
		"deno",
		"bun",
		"cloudflare-workers",
		"websocket"
	],
	"license": "MIT",
	"type": "module",
	"main": "dist/hocuspocus-server.cjs",
	"module": "dist/hocuspocus-server.esm.js",
	"types": "dist/packages/server/src/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/packages/server/src/index.d.ts",
			"import": "./dist/hocuspocus-server.esm.js",
			"require": "./dist/hocuspocus-server.cjs"
		},
		"./core": {
			"source": "./src/core.ts",
			"types": "./src/core.ts",
			"default": "./src/core.ts"
		},
		"./node": {
			"source": "./src/node.ts",
			"types": "./src/node.ts",
			"default": "./src/node.ts"
		},
		"./runtime": {
			"source": "./src/runtime.ts",
			"types": "./src/runtime.ts",
			"default": "./src/runtime.ts"
		}
	},
	"typesVersions": {
		"*": {
			"core": ["./src/core.ts"],
			"node": ["./src/node.ts"],
			"runtime": ["./src/runtime.ts"]
		}
	},
	"files": [
		"src",
		"dist"
	],
	"dependencies": {
		"@hocuspocus/common": "^3.4.3",
		"async-lock": "^1.3.1",
		"async-mutex": "^0.5.0",
		"kleur": "^4.1.4",
		"lib0": "^0.2.47"
	},
	"devDependencies": {
		"@types/async-lock": "^1.1.3",
		"@types/ws": "^8.5.3"
	},
	"peerDependencies": {
		"y-protocols": "^1.0.6",
		"yjs": "^13.6.8"
	},
	"peerDependenciesMeta": {
		"ws": {
			"optional": true
		}
	},
	"gitHead": "b3454a4ca289a84ddfb7fa5607a2d4b8d5c37e9d",
	"repository": {
		"url": "https://github.com/ueberdosis/hocuspocus"
	}
}
